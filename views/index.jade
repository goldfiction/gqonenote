extends layout

block content
    .well.well-lg
        .row
            .col-xs-12.col-md-12
                .d-flex.gap-2
                    div.inblock
                        p.inblock Project: 
                        button#addProject.btn.btn-secondary(type="button") [+]
                        button#removeProject.btn.btn-secondary(type="button") [-]
                        button#editProject.btn.btn-secondary(type="button") [E]
                        button#refreshProject.btn.btn-secondary(type="button") [R]
                        select(name="project",id="projects")
                    div.inblock
                        p.inblock Theme:
                        select(name="theme",id="themes")
                    div.inblock
                        p.inblock Language:
                        select(name="language",id="languages")
        .row
            .col-xs-12.col-md-2
                .border
                    div.inblock
                        p.inblock Section
                        button#addSection.btn.btn-secondary(type="button") [+]
                        button#removeSection.btn.btn-secondary(type="button") [-]
                        button#editSection.btn.btn-secondary(type="button") [E]
                        button#moveSection.btn.btn-secondary(type="button") [M]
                    div.inblock.wide#sections
                .border
                    div.inblock
                        p.inblock Page
                        button#addPage.btn.btn-secondary(type="button") [+]
                        button#removePage.btn.btn-secondary(type="button") [-]
                        button#editPage.btn.btn-secondary(type="button") [E]
                        button#movePage.btn.btn-secondary(type="button") [M]
                    div.inblock.wide#pages
                .border
                    div.inblock
                        p.inblock Note
                        button#addNote.btn.btn-secondary(type="button") [+]
                        button#removeNote.btn.btn-secondary(type="button") [-]
                        button#editNote.btn.btn-secondary(type="button") [E]
                        button#moveNote.btn.btn-secondary(type="button") [M]
                        button#saveNote.btn.btn-secondary(type="button") [Save]
                        button#saveAsNote.btn.btn-secondary(type="button") [Save As]
                        button#duplicateNote.btn.btn-secondary(type="button") [Duplicate]
                    div.inblock.wide#notes
            .col-xs-12.col-md-10
                ul.nav.nav-tabs#tabContent
                    li.nav-item
                        a#HTMLPageNav.btn(href="#HTMLPage",data-bs-toggle="tab",data-bs-target="#HTMLPage",aria-controls="HTMLPage",aria-selected="true") HTML
                    li.nav-item
                        a#editorPageNav.btn(href="#editorPage",data-bs-toggle="tab",data-bs-target="#editorPage",aria-controls="editorPage",aria-selected="true") Editor
                    li.nav-item
                        a#saveNoteNav(href="#") Save
                    li.nav-item
                        a#dbSize(href="#") Size 
                    li.nav-item
                        a#notePath(href="#") 
                    li.nav-item
                        a#run.btn(href="#") Run
                ul.nav.nav-tabs#tabContent2.fade.d-none.hide
                    li.nav-item
                        a#export.btn(href="#") Export
                    li.nav-item
                        a#import.btn(href="#") Import
                    li.nav-item
                        a#stop.btn(href="#") Stop Server
                    li.nav-item
                        a#restart.btn(href="#") Restart Server
                .tab-content
                    .tab-pane#HTMLPage
                        #HTMLContent
                    .tab-pane.active#editorPage
                        #editor
                        #statusBar
    #popupInputBox.popup.fade
        input#popupInput(type="text",placeholder="Type something...")
        button#submitBtn.btn.btn-primary OK
        button#cancelBtn.btn.btn-secondary Cancel
    #popupConfirmBox.popup.fade
        label#popupLabel Are you sure?
        button#confirmYesBtn.btn.btn-primary Yes
        button#confirmNoBtn.btn.btn-secondary No
    #popupMoveNoteBox.popup.fade
        label Project:
        select(name="project",id="moveProject")
        br
        label Section:
        select(name="section",id="moveSection")
        br
        label Page:
        select(name="page",id="movePage")
        br
        button#moveNoteBtn.btn.btn-primary Move
        button#copyNoteBtn.btn.btn-primary Copy
        button#cancelBtn.btn.btn-secondary Cancel
    #alertpopout.alert.alert-success.posabs(role="alert")
    #motd.alert.alert-success.posabs(role="alert")